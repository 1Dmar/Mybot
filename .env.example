# Discord Bot Configuration
# Use one of these token variables (BOT_TOKEN is recommended)
BOT_TOKEN=your_discord_bot_token_here
# Alternative token variables (for backwards compatibility)
BOT1_TOKEN=your_discord_bot_token_here
BOT1_1_TOKEN=your_discord_bot_token_here

# MongoDB Configuration
MONGO_URL=mongodb://your_mongodb_connection_string

# Bot Prefix
PREFIX=!

# Guild ID for testing slash commands
GuildID=1058104907204395008

# API Key
API_KEY=your_api_key_here

# Port (optional, defaults to 6269)
PORT=6269

# Node Environment
NODE_ENV=production

# Secondary Bot Token (ModMail)
MAIL_TOKEN=your_secondary_bot_token_here
